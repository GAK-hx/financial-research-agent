{
  "registry_version": "factor_registry_v1",
  "factors": [
    {"name":"momentum_20d","domain":"market","description":"20个交易日收盘价动量。","formula":"close_t / close_t_minus_20 - 1","input_fields":["close"],"window":21,"direction":"higher_is_better","null_rule":"少于21个有效交易日时为空。","adjustment":"qfq","standardization":"percentile_rank","winsorization":"none","formula_version":"market_factor_v1","point_in_time_eligible":true},
    {"name":"momentum_60d","domain":"market","description":"60个交易日收盘价动量。","formula":"close_t / close_t_minus_60 - 1","input_fields":["close"],"window":61,"direction":"higher_is_better","null_rule":"少于61个有效交易日时为空。","adjustment":"qfq","standardization":"percentile_rank","winsorization":"none","formula_version":"market_factor_v1","point_in_time_eligible":true},
    {"name":"reversal_5d","domain":"market","description":"五日收益的反向值。","formula":"-(close_t / close_t_minus_5 - 1)","input_fields":["close"],"window":6,"direction":"higher_is_better","null_rule":"少于6个有效交易日时为空。","adjustment":"qfq","standardization":"percentile_rank","winsorization":"none","formula_version":"market_factor_v1","point_in_time_eligible":true},
    {"name":"volatility_20d","domain":"market","description":"20日收益率年化样本波动率。","formula":"stddev_samp(daily_return,20) * sqrt(252)","input_fields":["close"],"window":21,"direction":"lower_is_better","null_rule":"少于21个有效交易日时为空。","adjustment":"qfq","standardization":"percentile_rank","winsorization":"none","formula_version":"market_factor_v1","point_in_time_eligible":true},
    {"name":"max_drawdown_60d","domain":"market","description":"60日窗口最大回撤绝对值。","formula":"abs(min(close / cumulative_max(close) - 1))","input_fields":["close"],"window":60,"direction":"lower_is_better","null_rule":"少于2个有效交易日时为空。","adjustment":"qfq","standardization":"percentile_rank","winsorization":"none","formula_version":"market_factor_v1","point_in_time_eligible":true},
    {"name":"relative_volume_20d","domain":"market","description":"最新成交量与20日均量之比。","formula":"volume_t / mean(volume,20)","input_fields":["volume"],"window":20,"direction":"neutral","null_rule":"少于20日或均量非正时为空。","adjustment":"qfq","standardization":"percentile_rank","winsorization":"none","formula_version":"market_factor_v1","point_in_time_eligible":true},
    {"name":"amihud_liquidity_20d","domain":"market","description":"20日Amihud非流动性指标并按一亿缩放。","formula":"mean(abs(daily_return) / amount,20) * 100000000","input_fields":["close","amount"],"window":21,"direction":"lower_is_better","null_rule":"少于21日或成交额非正时为空。","adjustment":"qfq","standardization":"percentile_rank","winsorization":"none","formula_version":"market_factor_v1","point_in_time_eligible":true},
    {"name":"revenue_growth","domain":"fundamental","description":"最新报告期营业收入同比增长。","formula":"revenue_yoy","input_fields":["revenue_yoy"],"window":null,"direction":"higher_is_better","null_rule":"源指标缺失时为空。","adjustment":"not_applicable","standardization":"percentile_rank","winsorization":"none","formula_version":"fundamental_factor_v1","point_in_time_eligible":false},
    {"name":"profit_growth","domain":"fundamental","description":"最新报告期归母净利润同比增长。","formula":"parent_net_profit_yoy","input_fields":["parent_net_profit_yoy"],"window":null,"direction":"higher_is_better","null_rule":"源指标缺失时为空。","adjustment":"not_applicable","standardization":"percentile_rank","winsorization":"none","formula_version":"fundamental_factor_v1","point_in_time_eligible":false},
    {"name":"roe","domain":"fundamental","description":"最新报告期口径ROE。","formula":"roe_period","input_fields":["roe_period"],"window":null,"direction":"higher_is_better","null_rule":"源指标缺失时为空。","adjustment":"not_applicable","standardization":"percentile_rank","winsorization":"none","formula_version":"fundamental_factor_v1","point_in_time_eligible":false},
    {"name":"operating_cashflow_to_profit","domain":"fundamental","description":"经营现金流与归母净利润之比。","formula":"operating_cash_flow / parent_net_profit","input_fields":["operating_cash_flow","parent_net_profit"],"window":null,"direction":"higher_is_better","null_rule":"任一输入缺失或净利润为零时为空。","adjustment":"not_applicable","standardization":"percentile_rank","winsorization":"none","formula_version":"fundamental_factor_v1","point_in_time_eligible":false},
    {"name":"debt_to_assets","domain":"fundamental","description":"资产负债率。","formula":"debt_ratio","input_fields":["debt_ratio"],"window":null,"direction":"lower_is_better","null_rule":"源指标缺失时为空。","adjustment":"not_applicable","standardization":"percentile_rank","winsorization":"none","formula_version":"fundamental_factor_v1","point_in_time_eligible":false}
  ]
